{
  "appId": "com.playquiem.app",
  "appName": "Playquiem",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": ["*.supabase.co", "*.igdb.com", "*.twitch.tv"]
  },
  "android": {
    "buildOptions": {
      "releaseType": "APK"
    }
  },
  "plugins": {
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#0A0A0A"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  }
}
